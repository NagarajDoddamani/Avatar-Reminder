{
  "name": "avatar-reminder",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Windows desktop reminder app with a 3D avatar",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.2",
    "better-sqlite3": "^11.8.1",
    "googleapis": "^144.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-rebuild": "^3.2.9",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
